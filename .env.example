# =============================================
# PostsApp Web — Environment Variables
# =============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.

# --- Supabase (public — safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (server-only — NEVER expose to browser) ---
# Used ONLY in server-side code (route handlers, server actions, scripts).
# Must NOT be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_SITE_URL=https://postsapp.in
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# --- Rate limiting (Upstash Redis or Postgres fallback) ---
# If using Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (configure for Supabase Auth SMTP or Resend) ---
# These are set in Supabase dashboard; listed here as documentation:
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SENDER

# --- Storage ---
# Bucket names (defaults shown — override per environment)
STORAGE_BUCKET_FEATURED=article-featured
STORAGE_BUCKET_CONTENT=article-content
STORAGE_BUCKET_AVATARS=author-avatars
STORAGE_BUCKET_SITE_ASSETS=site-assets
STORAGE_BUCKET_TEMP=editorial-temp

# --- CI / Secret scanning ---
# GITLEAKS_CONFIG is set in CI; no value needed here

# --- Canonical domain for SEO (no trailing slash) ---
CANONICAL_BASE_URL=https://postsapp.in
